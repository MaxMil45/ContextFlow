{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: every ContextFlow command except the switcher's and the corner card's own.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-list-snapshots",
    "allow-get-snapshot",
    "allow-capture-workspace",
    "allow-restore-workspace",
    "allow-switch-workspace",
    "allow-cancel-restore",
    "allow-create-shortcut",
    "allow-get-workspace-icon",
    "allow-set-workspace-icon",
    "allow-reset-workspace-icon",
    "allow-update-workspace",
    "allow-list-restore-runs",
    "allow-set-save-mode",
    "allow-set-workspace-archived",
    "allow-get-workspace-shortcuts",
    "allow-delete-workspace",
    "allow-set-pinned-version",
    "allow-delete-snapshot",
    "allow-get-trust-review",
    "allow-approve-workspace",
    "allow-list-running-apps",
    "allow-get-cleanup-config",
    "allow-set-cleanup-config",
    "allow-preview-cleanup",
    "allow-run-cleanup-now",
    "allow-leave-workspace",
    "allow-discover-capture",
    "allow-compare-snapshots",
    "allow-get-settings",
    "allow-get-hotkey-status",
    "allow-save-settings",
    "allow-get-browser-status",
    "allow-install-browser-integration",
    "allow-remove-browser-integration",
    "allow-open-folder",
    "allow-backup-now",
    "allow-export-workspaces",
    "allow-import-workspaces",
    "allow-verify-data",
    "allow-preview-retention",
    "allow-apply-retention",
    "allow-refresh-tray-menu",
    "allow-take-ui-action",
    "allow-health-check",
    "allow-save-diagnostics"
  ]
}