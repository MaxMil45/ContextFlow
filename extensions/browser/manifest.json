{
  "manifest_version": 3,
  "name": "ContextFlow",
  "version": "0.2.0",
  "description": "Tells the ContextFlow app on this computer which tabs are open, so it can reopen them later. Nothing leaves your computer.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "background.js" }
}
